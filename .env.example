# 复制本文件为 .env 后按需修改（.env 不要提交到仓库）

# 用于签名登录 Cookie 的密钥，部署时务必改成一串随机字符
# 留空时：程序会自动生成一个并保存在 DATA_DIR/secret_key 文件中
SECRET_KEY=

# 数据目录：SQLite 数据库和上传的照片都放在这里
DATA_DIR=data

# 监听端口
PORT=8080

# DeepSeek 模型名
DEEPSEEK_MODEL=deepseek-chat

# 演示模式：1 = 开启，0 = 关闭
DEMO_MODE=0

# 仅供开发者运行 test_ai.py 使用；正式功能里的 key 由用户在网页上填写
DEEPSEEK_API_KEY=
